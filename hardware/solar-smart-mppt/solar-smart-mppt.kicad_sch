    (pin "1" (uuid 5e675b79-e294-4df6-aba5-bc71a564ac5b))
    (instances (project "solar-smart-mppt" (path "/6b1f3c1e-6a5e-4b7e-9d65-5f0b3a1d0003" (reference "#PWR042") (unit 1))))
