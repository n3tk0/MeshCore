  (symbol (lib_id "xiao_solar:PWR_3V3M") (at 420 150.38 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid c6456efb-ee51-4d0f-9763-21d858d81d1b)
    (property "Reference" "#PWR042" (at 420 150.38 0) (effects (font (size 1.27 1.27)) hide))
