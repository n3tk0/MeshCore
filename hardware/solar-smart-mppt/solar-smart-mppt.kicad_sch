  (symbol (lib_id "xiao_solar:PWR_3V3M") (at 420 150.38 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid c57242b1-d1dd-44de-acf3-0bac0660b2dc)
    (property "Reference" "#PWR042" (at 420 150.38 0) (effects (font (size 1.27 1.27)) hide))
