  (text "1. ВХОД (5-22 V соларен панел) -> MPPT ЗАРЯДНО BQ25798 (PROG 1S, 750 kHz, 2.2 uH)" (at 20 22 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 3e5e69fb-b1c8-4445-b46c-d73d2a076cc0))
