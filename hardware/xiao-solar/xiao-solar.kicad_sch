  (no_connect (at 331.11 233.08) (uuid 1ec2c068-4b44-4f3e-a1ab-3c98a6b32651))
  (text "1. ВХОДОВЕ (5-22 V соларен панел + втори вход) -> MPPT ЗАРЯДНО BQ25798 (1S, 750 kHz, 2.2 uH)" (at 20 22 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 51b1b0c0-f028-4b78-b4ac-6a2348af9024))
  (text "SS54 = OR на двата входа + защита от обратна полярност. D3 (SMBJ24A) пази VBUS до 25 V." (at 20 174 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 88ebe04e-1d6e-4b12-8b8c-e44299f8bdfa))
  (text "CE (D0): JP2 1-2 (Li-ion) зарежда автоматично; 2-3 (LiFePO4) изчаква фърмуера (VREG=3.6V, D0=0). TP2 (QON) към GND = wake." (at 20 177.5 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 1d3160c9-31df-4b5c-b728-e55ffea52013))
  (text "2. СИСТЕМНО ЗАХРАНВАНЕ (SYS -> LM66100 -> XIAO 5V) + XIAO nRF52840 & Wio-SX1262 + I2C" (at 225 22 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 81797c2c-ed55-4268-9578-8a6e1e67c1db))
  (text "3. БАТЕРИЯ 1S (Li-ion / LiFePO4): Ship FET (Q2 + JP3) -> Шунт RS1 (INA219) -> BMS (DW01A + HJ8205) -> J4" (at 20 188 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 1d477d69-81bc-4352-a395-bd9d41628d9c))
  (text "Q2 (AO3400A): S към BAT, D към батерията; в shutdown спира разреждането. За LiFePO4: затвори JP3 (без Q2)." (at 20 252 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid b72e8e00-4b45-452d-a246-abc25114ac5f))
  (text "BMS (DW01A + HJ8205) в минуса на батерията (BATT- към GND): защита от презареждане (4.3V), преразреждане (2.4V) и късо." (at 20 255.5 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid f0257ec5-e82c-42f8-b6e1-841f6ea6ffc4))
  (sheet_instances (path "/" (page "1")))
