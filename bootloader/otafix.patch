diff --git a/src/main.c b/src/main.c
index bd99713..a38b5f3 100644
--- a/src/main.c
+++ b/src/main.c
@@ -160,6 +160,8 @@ static void mbr_init_sd(void) {
 //--------------------------------------------------------------------+
 //
 //--------------------------------------------------------------------+
+void ota_stage_run(void);   // src/ota_stage.c
+
 int main(void) {
   // Populate Boot Address and MBR Param into MBR if not already
   // MBR_BOOTLOADER_ADDR/MBR_PARAM_PAGE_ADDR are used if available, else UICR registers are used
@@ -185,6 +187,10 @@ int main(void) {
     led_state(STATE_WRITING_FINISHED);
   }
 
+  // LoRa OTA from a MeshCore repeater: a staged image to copy over the app (or the old one back).
+  // Not when the app jumped here with the SoftDevice running: it owns the flash then.
+  if (NRF_POWER->GPREGRET != DFU_MAGIC_OTA_APPJUM) ota_stage_run();
+
   // Check all inputs and enter DFU if needed
   // Return when DFU process is complete (or not entered at all)
   check_dfu_mode();
