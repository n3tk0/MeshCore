+void ota_stage_run(void);   // src/ota_stage.c
+
 int main(void) {
   // Populate Boot Address and MBR Param into MBR if not already
   // MBR_BOOTLOADER_ADDR/MBR_PARAM_PAGE_ADDR are used if available, else UICR registers are used
@@ -185,6 +187,10 @@ int main(void) {
     led_state(STATE_WRITING_FINISHED);
   }
 
+  // LoRa OTA from a MeshCore repeater: a staged image to copy over the app (or the old one back).
